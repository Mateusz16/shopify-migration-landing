# Skopiuj ten plik do .env i uzupełnij po założeniu projektu na sanity.io
# (patrz README, sekcja "Sanity CMS").

# Publiczne identyfikatory projektu Sanity — nie są sekretem, można je znaleźć
# w https://www.sanity.io/manage w ustawieniach projektu.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Token z uprawnieniem zapisu (Editor/Write) — tylko do jednorazowego skryptu
# `npm run sanity:seed`, który wgrywa dzisiejszą treść jako punkt startowy do
# edycji w Studio. Wygeneruj w https://www.sanity.io/manage → API → Tokens.
# NIE commituj tego tokena — plik .env jest w .gitignore.
SANITY_API_WRITE_TOKEN=
