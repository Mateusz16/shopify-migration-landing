---
import { Image } from 'astro:assets';
import avatar from '../assets/images/mateusz-avatar.jpg';

const navLinks = [
  { href: '#dla-kogo', label: 'Dla kogo' },
  { href: '#zakres', label: 'Zakres' },
  { href: '#proces', label: 'Proces' },
  { href: '#cennik', label: 'Cennik' },
  { href: '#case-studies', label: 'Case studies' },
  { href: '#o-mnie', label: 'O mnie' },
];
---

<div
  id="scroll-progress"
  class="fixed left-0 top-0 z-[60] h-[2px] w-full origin-left bg-signal"
  style="transform: scaleX(0)"
  aria-hidden="true"
>
</div>

<header id="site-header" class="sticky top-0 z-50 px-4 pt-4 transition-[padding] duration-300 sm:px-6">
  <div
    id="navbar-pill"
    class="mx-auto flex max-w-content items-center justify-between gap-3 rounded-full border border-ink/10 bg-canvas/70 py-3 pl-2.5 pr-2.5 shadow-lg shadow-ink/5 backdrop-blur-xl transition-all duration-300 sm:pl-3 sm:pr-3"
  >
    <a href="#top" class="group flex min-w-0 items-center gap-2.5">
      <span class="avatar-pulse relative shrink-0 rounded-full">
        <Image
          src={avatar}
          alt="Mateusz Klawitter"
          width={80}
          height={80}
          class="h-10 w-10 rounded-full object-cover brightness-90 ring-2 ring-porcelain transition-transform duration-300 group-hover:scale-105"
        />
        <span
          class="absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full border-2 border-canvas bg-mint"
          aria-hidden="true"
        ></span>
      </span>
      <span class="flex min-w-0 items-baseline gap-1.5">
        <span class="truncate font-display text-[15px] font-semibold tracking-tight text-ink sm:text-base">
          MK
        </span>
      </span>
    </a>

    <nav id="site-nav" aria-label="Nawigacja główna" class="hidden items-center lg:flex">
      {
        navLinks.map((link) => (
          <a href={link.href} class="nav-link text-sm font-medium text-ink-soft/80 hover:text-ink">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <a
        href="#kontakt"
        class="group inline-flex items-center gap-2.5 rounded-full bg-ink py-2.5 pl-4 pr-5 text-sm font-semibold text-porcelain transition-colors hover:bg-signal"
      >
        <span class="status-dot relative h-2 w-2 rounded-full bg-mint text-mint" aria-hidden="true"></span>
        Umów audyt
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-full border border-ink/15 p-2.5 text-ink lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="sr-only">Otwórz menu</span>
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="4" y1="8" x2="20" y2="8"></line>
        <line x1="4" y1="16" x2="14" y2="16"></line>
      </svg>
      <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="5" y1="5" x2="19" y2="19"></line>
        <line x1="19" y1="5" x2="5" y2="19"></line>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Nawigacja mobilna"
    class="mx-auto mt-2 hidden max-w-content flex-col gap-1 rounded-[1.25rem] border border-ink/10 bg-canvas/95 px-4 pb-4 pt-3 shadow-xl shadow-ink/10 backdrop-blur-xl lg:hidden"
  >
    {
      navLinks.map((link, i) => (
        <a
          href={link.href}
          class="flex items-baseline justify-between rounded-xl px-3 py-2.5 text-base font-medium text-ink-soft hover:bg-porcelain hover:text-signal"
        >
          {link.label}
          <span class="font-mono text-[10px] text-ink-soft/40">0{i + 1}</span>
        </a>
      ))
    }
    <a
      href="#kontakt"
      class="mt-2 inline-flex items-center justify-center gap-2.5 rounded-full bg-ink px-4 py-3 text-sm font-semibold text-porcelain"
    >
      <span class="status-dot relative h-2 w-2 rounded-full bg-mint text-mint" aria-hidden="true"></span>
      Umów audyt
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('flex');
    mobileNav?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav.classList.add('hidden');
      mobileNav.classList.remove('flex');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // Pigułka kurczy się po przewinięciu + pasek postępu lektury u góry ekranu.
  const siteHeader = document.getElementById('site-header');
  const navbarPill = document.getElementById('navbar-pill');
  const progressBar = document.getElementById('scroll-progress');
  const SCROLL_THRESHOLD = 24;

  const updateScrollState = () => {
    const isScrolled = window.scrollY > SCROLL_THRESHOLD;
    siteHeader?.classList.toggle('is-scrolled', isScrolled);
    navbarPill?.classList.toggle('is-scrolled', isScrolled);

    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
    progressBar?.style.setProperty('transform', `scaleX(${progress})`);
  };

  updateScrollState();
  window.addEventListener('scroll', updateScrollState, { passive: true });

  // Scrollspy: podświetlenie linku sekcji widocznej na ekranie.
  const navAnchors = Array.from(document.querySelectorAll<HTMLAnchorElement>('#site-nav a'));
  const sections = navAnchors
    .map((anchor) => document.querySelector<HTMLElement>(anchor.hash))
    .filter((section): section is HTMLElement => section !== null);

  if ('IntersectionObserver' in window && sections.length > 0) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navAnchors.forEach((anchor) =>
            anchor.classList.toggle('nav-active', anchor.hash === `#${entry.target.id}`),
          );
        });
      },
      { rootMargin: '-35% 0px -55% 0px' },
    );

    sections.forEach((section) => spy.observe(section));
  }
</script>
