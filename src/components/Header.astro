---
import { Image } from 'astro:assets';
import avatar from '../assets/images/mateusz-avatar.jpg';

const navLinks = [
  { href: '#dla-kogo', label: 'Dla kogo' },
  { href: '#zakres', label: 'Zakres' },
  { href: '#proces', label: 'Proces' },
  { href: '#cennik', label: 'Cennik' },
  { href: '#case-studies', label: 'Case studies' },
  { href: '#o-mnie', label: 'O mnie' },
];
---

<header id="site-header" class="sticky top-0 z-50 px-4 pt-4 transition-[padding] duration-300 sm:px-6">
  <div
    id="navbar-pill"
    class="mx-auto flex max-w-content items-center justify-between rounded-full border border-ink/10 bg-canvas/75 px-4 py-3 shadow-lg shadow-ink/5 backdrop-blur-md transition-all duration-300 sm:px-6"
  >
    <a href="#top" class="flex items-center gap-2.5">
      <Image
        src={avatar}
        alt="Mateusz Klawitter"
        width={72}
        height={72}
        class="h-9 w-9 rounded-full object-cover ring-2 ring-porcelain sm:h-10 sm:w-10"
      />
      <span class="font-display text-lg font-semibold tracking-tight text-ink">
        MK<span class="text-signal">/</span>Shopify
      </span>
    </a>

    <nav aria-label="Nawigacja główna" class="hidden lg:flex items-center gap-7">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-ink-soft hover:text-signal transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <a
        href="#kontakt"
        class="inline-flex items-center rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-porcelain hover:bg-signal transition-colors"
      >
        Umów audyt
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="lg:hidden inline-flex items-center justify-center rounded-full border border-ink/20 p-2 text-ink"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="sr-only">Otwórz menu</span>
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
      <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="5" y1="5" x2="19" y2="19"></line>
        <line x1="19" y1="5" x2="5" y2="19"></line>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Nawigacja mobilna"
    class="mx-auto hidden lg:hidden max-w-content flex-col gap-1 rounded-2xl border border-ink/10 bg-canvas px-5 pb-5 pt-3 mt-2 shadow-lg shadow-ink/5"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-sm px-2 py-2.5 text-base font-medium text-ink-soft hover:bg-porcelain hover:text-signal"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href="#kontakt"
      class="mt-2 inline-flex items-center justify-center rounded-full bg-ink px-4 py-3 text-sm font-semibold text-porcelain"
    >
      Umów audyt
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('flex');
    mobileNav?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav.classList.add('hidden');
      mobileNav.classList.remove('flex');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // Pigułka navbar "kurczy się" po przewinięciu strony.
  const siteHeader = document.getElementById('site-header');
  const navbarPill = document.getElementById('navbar-pill');
  const SCROLL_THRESHOLD = 24;

  const updateScrollState = () => {
    const isScrolled = window.scrollY > SCROLL_THRESHOLD;
    siteHeader?.classList.toggle('is-scrolled', isScrolled);
    navbarPill?.classList.toggle('is-scrolled', isScrolled);
  };

  updateScrollState();
  window.addEventListener('scroll', updateScrollState, { passive: true });
</script>
