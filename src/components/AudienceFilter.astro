---
import SectionHeading from './SectionHeading.astro';
import { fetchSingleton } from '../lib/sanity/content';
import { audienceFilterQuery } from '../lib/sanity/queries';
import { audienceFilterDefault } from '../lib/sanity/defaults';

const section = await fetchSingleton(audienceFilterQuery, audienceFilterDefault);
const { eyebrow, title, description, fitsHeading, fits, notFitsHeading, notFits } = section;
---

<section id="dla-kogo" class="mx-auto max-w-content px-5 py-20 sm:px-8 sm:py-28">
  <SectionHeading eyebrow={eyebrow} title={title} description={description} />

  <div class="mt-12 grid gap-6 lg:grid-cols-2">
    <div class="reveal rounded-md border border-mint/30 bg-mint-soft/60 p-6 sm:p-8">
      <h3 class="font-display text-xl font-semibold text-ink">{fitsHeading}</h3>
      <ul class="mt-5 flex flex-col gap-4">
        {
          fits.map((item) => (
            <li class="flex gap-3 text-[15px] leading-relaxed text-ink-soft">
              <span class="mt-1 text-mint" aria-hidden="true">✓</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="reveal rounded-md border border-ember/30 bg-ember-soft/50 p-6 sm:p-8">
      <h3 class="font-display text-xl font-semibold text-ink">{notFitsHeading}</h3>
      <ul class="mt-5 flex flex-col gap-4">
        {
          notFits.map((item) => (
            <li class="flex gap-3 text-[15px] leading-relaxed text-ink-soft">
              <span class="mt-1 text-ember" aria-hidden="true">✕</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
