---
import { fetchSingleton } from '../lib/sanity/content';
import { contactCtaQuery, siteSettingsQuery } from '../lib/sanity/queries';
import { contactCtaDefault, siteSettingsDefault } from '../lib/sanity/defaults';

const [contact, siteSettings] = await Promise.all([
  fetchSingleton(contactCtaQuery, contactCtaDefault),
  fetchSingleton(siteSettingsQuery, siteSettingsDefault),
]);
const { eyebrow, title, description, mailSubject, mailBody, checklistHeading, checklistItems } = contact;
const email = siteSettings.contactEmail;
const subject = encodeURIComponent(mailSubject);
const body = encodeURIComponent(mailBody);
---

<section id="kontakt" class="mx-auto max-w-content px-5 py-20 sm:px-8 sm:py-28">
  <div class="reveal rounded-lg border border-ink/10 bg-porcelain p-8 sm:p-14">
    <div class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-signal font-medium">{eyebrow}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-semibold text-ink">{title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft/85">
        {description}
      </p>
    </div>

    <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <a
        href={`mailto:${email}?subject=${subject}&body=${body}`}
        class="inline-flex items-center justify-center rounded-sm bg-ink px-6 py-4 text-base font-semibold text-porcelain hover:bg-signal transition-colors"
      >
        Napisz: {email}
      </a>

      <div class="max-w-sm">
        <p class="text-xs uppercase tracking-wide text-ink-soft/50 font-mono">{checklistHeading}</p>
        <ul class="mt-3 flex flex-col gap-2 text-sm text-ink-soft/80">
          {checklistItems.map((item) => <li>— {item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
