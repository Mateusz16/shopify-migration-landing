---
const points = [
  {
    title: 'Doświadczenie z dwóch stron',
    body: 'Kilka lat w IT po stronie inżynierskiej i kilka lat po stronie e-commerce — rozumiem zarówno kod sklepu, jak i to, co faktycznie wpływa na sprzedaż.',
  },
  {
    title: 'AI-first, nie AI-hype',
    body: 'Pracuję z Claude Code jako głównym narzędziem developerskim. To przewaga w tempie i jakości audytu — nie zamiennik decyzji, które i tak podejmuję sam.',
  },
  {
    title: 'Jeden ekspert, nie zespół juniorów',
    body: 'Każdy projekt prowadzę osobiście, od audytu po maintenance. Dlatego limit 4–5 klientów jednocześnie — to warunek utrzymania jakości, nie marketingowy trik.',
  },
];
---

<section id="o-mnie" class="mx-auto max-w-content px-5 py-20 sm:px-8 sm:py-28">
  <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div class="reveal">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-signal font-medium">O mnie</p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-semibold text-ink">Mateusz Klawitter</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft/85">
        Migruję sklepy e-commerce do Shopify jako jednoosobowy zespół
        wspierany przez AI-first proces developerski — nie jako agencja z
        wieloma projektami naraz.
      </p>
    </div>

    <div class="flex flex-col gap-8">
      {
        points.map((point) => (
          <div class="reveal border-l-2 border-signal/40 pl-5">
            <h3 class="font-display text-lg font-semibold text-ink">{point.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-soft/85">{point.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
