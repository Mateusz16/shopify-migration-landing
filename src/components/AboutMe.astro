---
import { fetchSingleton } from '../lib/sanity/content';
import { aboutMeQuery } from '../lib/sanity/queries';
import { aboutMeDefault } from '../lib/sanity/defaults';
import { urlFor } from '../lib/sanity/image';

const about = await fetchSingleton(aboutMeQuery, aboutMeDefault);
const { eyebrow, name, intro, points, portrait } = about;
const portraitUrl = portrait ? urlFor(portrait).width(480).height(480).url() : null;
const portraitAlt = portrait?.alt || name;
---

<section id="o-mnie" class="mx-auto max-w-content px-5 py-20 sm:px-8 sm:py-28">
  <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div class="reveal">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-signal font-medium">{eyebrow}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-semibold text-ink">{name}</h2>
      {
        portraitUrl && (
          <img
            src={portraitUrl}
            alt={portraitAlt}
            width="240"
            height="240"
            class="mt-6 aspect-square w-40 rounded-md object-cover"
            loading="lazy"
          />
        )
      }
      <p class="mt-5 text-lg leading-relaxed text-ink-soft/85">
        {intro}
      </p>
    </div>

    <div class="flex flex-col gap-8">
      {
        points.map((point) => (
          <div class="reveal border-l-2 border-signal/40 pl-5">
            <h3 class="font-display text-lg font-semibold text-ink">{point.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-soft/85">{point.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
