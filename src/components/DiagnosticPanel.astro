---
interface ChartData {
  label: string;
  current: string;
  delta: string;
  deltaTone: 'mint' | 'signal';
  linePath: string;
  areaPath: string;
}

const charts: ChartData[] = [
  {
    label: 'Koszt utrzymania IT (rocznie)',
    current: '-38%',
    delta: 'niżej niż na starej platformie',
    deltaTone: 'signal',
    linePath: 'M10,12 L65,32.4 L120,49.8 L175,64.4 L230,76',
    areaPath: 'M10,12 L65,32.4 L120,49.8 L175,64.4 L230,76 L230,88 L10,88 Z',
  },
  {
    label: 'Konwersja',
    current: '+72%',
    delta: 'wzrost po migracji',
    deltaTone: 'mint',
    linePath: 'M10,76 L65,60 L120,47.56 L175,31.56 L230,12',
    areaPath: 'M10,76 L65,60 L120,47.56 L175,31.56 L230,12 L230,88 L10,88 Z',
  },
];
---

<div class="reveal relative">
  <div
    class="relative overflow-hidden rounded-lg border border-white/10 bg-ink p-6 text-porcelain shadow-[0_30px_60px_-25px_rgba(20,23,28,0.55)] sm:p-8"
  >
    <div class="bg-grid pointer-events-none absolute inset-0 text-white/[0.06]" aria-hidden="true"></div>

    <span class="absolute left-4 top-4 h-3 w-3 border-l-2 border-t-2 border-mint/60" aria-hidden="true"></span>
    <span class="absolute right-4 top-4 h-3 w-3 border-r-2 border-t-2 border-mint/60" aria-hidden="true"></span>
    <span class="absolute bottom-4 left-4 h-3 w-3 border-b-2 border-l-2 border-mint/60" aria-hidden="true"></span>
    <span class="absolute bottom-4 right-4 h-3 w-3 border-b-2 border-r-2 border-mint/60" aria-hidden="true"></span>

    <div class="relative flex items-center justify-between border-b border-white/10 pb-4">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-porcelain/60">
        Diagnostyka // przed i po migracji
      </p>
      <span class="flex items-center gap-2 font-mono text-xs text-mint">
        <span class="h-1.5 w-1.5 rounded-full bg-mint" aria-hidden="true"></span>
        model referencyjny
      </span>
    </div>

    <div class="relative mt-6 grid gap-6 sm:grid-cols-2">
      {
        charts.map((chart) => (
          <div class="flex flex-col gap-3">
            <p class="text-xs text-porcelain/60">{chart.label}</p>
            <svg viewBox="0 0 240 96" class="w-full" role="img" aria-label={`${chart.label}: ${chart.current}`}>
              <defs>
                <linearGradient id={`gradient-${chart.deltaTone}`} x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color={chart.deltaTone === 'mint' ? '#1f9d6c' : '#3452ff'} stop-opacity="0.35" />
                  <stop offset="100%" stop-color={chart.deltaTone === 'mint' ? '#1f9d6c' : '#3452ff'} stop-opacity="0" />
                </linearGradient>
              </defs>
              <path d={chart.areaPath} fill={`url(#gradient-${chart.deltaTone})`} stroke="none" />
              <path
                d={chart.linePath}
                fill="none"
                stroke={chart.deltaTone === 'mint' ? '#1f9d6c' : '#3452ff'}
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                pathLength="1"
                class="chart-line"
              />
            </svg>
            <p class="flex items-baseline gap-2">
              <span class:list={['font-mono text-xl font-semibold tabular-nums', chart.deltaTone === 'mint' ? 'text-mint' : 'text-signal-soft']}>
                {chart.current}
              </span>
              <span class="text-xs text-porcelain/50">{chart.delta}</span>
            </p>
          </div>
        ))
      }
    </div>

    <p class="relative mt-6 border-t border-white/10 pt-4 font-mono text-[11px] leading-relaxed text-porcelain/40">
      Wartości ilustracyjne — typowy zakres poprawy na bazie audytów sklepów
      WooCommerce/PrestaShop migrowanych na Shopify. Realne liczby Twojego
      sklepu poznasz po audycie.
    </p>
  </div>
</div>
