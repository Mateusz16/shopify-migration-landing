---
// Panel "wyników" w Hero — jeden wykres z dwiema seriami (koszt w dół, konwersja w górę),
// w stylistyce jasnego panelu admina (a la Shopify), z przypisem o wartościach ilustracyjnych.
interface Point {
  x: number;
  y: number;
}

interface Series {
  id: string;
  label: string;
  value: string;
  caption: string;
  color: string;
  points: Point[];
}

const CHART_WIDTH = 600;
const CHART_HEIGHT = 220;
const PAD_X = 24;
const BASELINE_Y = 186;
const AXIS_LABEL_Y = 210;
const GRID_Y = [36, 79, 122, 165];
const MONTHS = ['Sty', 'Lut', 'Mar', 'Kwi', 'Maj', 'Cze', 'Lip', 'Sie'];

const series: Series[] = [
  {
    id: 'koszt',
    label: 'Koszt utrzymania IT (rocznie)',
    value: '-38%',
    caption: 'niżej niż na starej platformie',
    color: '#3452ff',
    points: [
      { x: 24, y: 66 },
      { x: 106, y: 60 },
      { x: 188, y: 78 },
      { x: 270, y: 92 },
      { x: 352, y: 86 },
      { x: 434, y: 112 },
      { x: 516, y: 122 },
      { x: 576, y: 136 },
    ],
  },
  {
    id: 'konwersja',
    label: 'Konwersja w checkoucie',
    value: '+72%',
    caption: 'wzrost po migracji',
    color: '#1f9d6c',
    points: [
      { x: 24, y: 170 },
      { x: 106, y: 158 },
      { x: 188, y: 150 },
      { x: 270, y: 128 },
      { x: 352, y: 106 },
      { x: 434, y: 86 },
      { x: 516, y: 56 },
      { x: 576, y: 36 },
    ],
  },
];

const toLinePath = (points: Point[]) =>
  points.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x},${p.y}`).join(' ');

const toAreaPath = (points: Point[]) =>
  `${toLinePath(points)} L${points[points.length - 1].x},${BASELINE_Y} L${points[0].x},${BASELINE_Y} Z`;
---

<div class="reveal relative">
  <div
    class="pointer-events-none absolute -inset-6 rounded-[2rem] bg-signal/[0.06] blur-2xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative overflow-hidden rounded-2xl border border-ink/10 bg-porcelain shadow-[0_40px_80px_-35px_rgba(20,23,28,0.25)]"
  >
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/10 px-6 py-4 sm:px-7">
      <div>
        <p class="font-display text-base font-semibold text-ink">Wyniki po migracji</p>
        <p class="mt-0.5 text-xs text-ink-soft/60">Model referencyjny — 8 miesięcy od wdrożenia</p>
      </div>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-ink/10 bg-canvas px-3 py-1 font-mono text-[11px] text-ink-soft">
        <span class="status-dot relative h-1.5 w-1.5 rounded-full bg-mint text-mint" aria-hidden="true"></span>
        na żywo
      </span>
    </div>

    <div class="grid gap-4 border-b border-ink/10 px-6 py-4 sm:grid-cols-2 sm:px-7">
      {
        series.map((s) => (
          <div class="flex items-baseline gap-2.5">
            <span class="h-2.5 w-2.5 shrink-0 self-center rounded-full" style={`background-color: ${s.color}`} aria-hidden="true" />
            <span class="font-mono text-2xl font-semibold text-ink">{s.value}</span>
            <span class="text-xs leading-snug text-ink-soft/60">{s.caption}</span>
          </div>
        ))
      }
    </div>

    <div class="px-3 pb-2 pt-5 sm:px-5">
      <svg
        viewBox={`0 0 ${CHART_WIDTH} ${CHART_HEIGHT}`}
        class="w-full"
        role="img"
        aria-label={`${series[0].label}: ${series[0].value} ${series[0].caption}. ${series[1].label}: ${series[1].value} ${series[1].caption}.`}
      >
        <defs>
          {
            series.map((s) => (
              <linearGradient id={`area-${s.id}`} x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color={s.color} stop-opacity="0.16" />
                <stop offset="100%" stop-color={s.color} stop-opacity="0" />
              </linearGradient>
            ))
          }
        </defs>

        <g stroke="rgba(20,23,28,0.08)" stroke-width="1" aria-hidden="true">
          {GRID_Y.map((y) => <line x1={PAD_X} y1={y} x2={CHART_WIDTH - PAD_X} y2={y} />)}
        </g>

        {
          series.map((s) => (
            <g>
              <path d={toAreaPath(s.points)} fill={`url(#area-${s.id})`} stroke="none" />
              <path
                d={toLinePath(s.points)}
                fill="none"
                stroke={s.color}
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                pathLength="1"
                class="chart-line"
              />
              {s.points.slice(0, -1).map((p) => (
                <circle cx={p.x} cy={p.y} r="2.5" fill={s.color} opacity="0.45" />
              ))}
              <circle
                cx={s.points[s.points.length - 1].x}
                cy={s.points[s.points.length - 1].y}
                r="5"
                fill={s.color}
                stroke="#faf9f5"
                stroke-width="2.5"
                class="chart-dot"
              />
            </g>
          ))
        }

        <g font-family="var(--font-mono)" font-size="11" fill="rgba(20,23,28,0.4)">
          {MONTHS.map((m, i) => (
            <text x={series[0].points[i].x} y={AXIS_LABEL_Y} text-anchor="middle">
              {m}
            </text>
          ))}
        </g>
      </svg>
    </div>

    <div class="border-t border-ink/10 px-6 py-4 sm:px-7">
      <p class="text-sm font-medium text-ink">Audyt sklepu → wycena w 3–7 dni</p>
      <p class="mt-2 font-mono text-[11px] leading-relaxed text-ink-soft/45">
        Wartości ilustracyjne — typowy zakres poprawy na bazie audytów sklepów
        WooCommerce/PrestaShop migrowanych na Shopify. Realne liczby Twojego
        sklepu poznasz po audycie.
      </p>
    </div>
  </div>
</div>
