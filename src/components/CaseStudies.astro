---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import CaseStudyCard from './CaseStudyCard.astro';

const entries = (await getCollection('case-studies')).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
---

<section id="case-studies" class="bg-porcelain">
  <div class="mx-auto max-w-content px-5 py-20 sm:px-8 sm:py-28">
    <SectionHeading
      eyebrow="Case studies"
      title="Wyniki wdrożeń"
      description="Pierwsze migracje są w toku — case studies z realnymi liczbami pojawią się tutaj po ich zakończeniu."
    />

    <div class="reveal mt-8 rounded-md border border-ink/10 bg-canvas p-5 text-sm text-ink-soft/80">
      Poniższa karta pokazuje wyłącznie strukturę case study (przykładowe,
      fikcyjne dane) — nie jest to wynik realnego wdrożenia.
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {entries.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>
  </div>
</section>
