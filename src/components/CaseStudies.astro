---
import SectionHeading from './SectionHeading.astro';
import CaseStudyCard from './CaseStudyCard.astro';
import { fetchSingleton, fetchList } from '../lib/sanity/content';
import { caseStudiesSectionQuery, caseStudiesQuery } from '../lib/sanity/queries';
import { caseStudiesSectionDefault, caseStudiesDefault } from '../lib/sanity/defaults';

const [section, entries] = await Promise.all([
  fetchSingleton(caseStudiesSectionQuery, caseStudiesSectionDefault),
  fetchList(caseStudiesQuery, caseStudiesDefault),
]);
const { eyebrow, title, description, placeholderNotice } = section;
const showPlaceholderNotice = placeholderNotice && entries.some((entry) => entry.isPlaceholder);
---

<section id="case-studies" class="bg-porcelain">
  <div class="mx-auto max-w-content px-5 py-20 sm:px-8 sm:py-28">
    <SectionHeading eyebrow={eyebrow} title={title} description={description} />

    {
      showPlaceholderNotice && (
        <div class="reveal mt-8 rounded-md border border-ink/10 bg-canvas p-5 text-sm text-ink-soft/80">
          {placeholderNotice}
        </div>
      )
    }

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {entries.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>
  </div>
</section>
