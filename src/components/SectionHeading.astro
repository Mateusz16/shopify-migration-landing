---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl reveal', align === 'center' && 'mx-auto text-center']}>
  <p
    class="font-mono text-xs uppercase tracking-[0.2em] text-signal font-medium"
  >
    {eyebrow}
  </p>
  <h2 class="mt-3 text-3xl sm:text-4xl font-semibold text-ink">
    {title}
  </h2>
  {description && <p class="mt-4 text-lg text-ink-soft/80 leading-relaxed">{description}</p>}
</div>
