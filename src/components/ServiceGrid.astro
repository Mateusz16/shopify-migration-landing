---
import SectionHeading from './SectionHeading.astro';
import { fetchSingleton } from '../lib/sanity/content';
import { serviceGridQuery } from '../lib/sanity/queries';
import { serviceGridDefault } from '../lib/sanity/defaults';

const section = await fetchSingleton(serviceGridQuery, serviceGridDefault);
const { eyebrow, title, description, services } = section;
---

<section id="zakres" class="bg-porcelain">
  <div class="mx-auto max-w-content px-5 py-20 sm:px-8 sm:py-28">
    <SectionHeading eyebrow={eyebrow} title={title} description={description} />

    <div class="mt-12 grid gap-px overflow-hidden rounded-md border border-ink/10 bg-ink/10 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <div class="reveal flex flex-col gap-3 bg-porcelain p-6 sm:p-7">
            <span class="font-mono text-xs text-signal">{service.number}</span>
            <h3 class="font-display text-lg font-semibold text-ink">{service.title}</h3>
            <p class="text-[15px] leading-relaxed text-ink-soft/85">{service.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
