---
import SectionHeading from './SectionHeading.astro';
import { fetchSingleton } from '../lib/sanity/content';
import { processStepsQuery } from '../lib/sanity/queries';
import { processStepsDefault } from '../lib/sanity/defaults';

const section = await fetchSingleton(processStepsQuery, processStepsDefault);
const { eyebrow, title, description, steps } = section;
---

<section id="proces" class="mx-auto max-w-content px-5 py-20 sm:px-8 sm:py-28">
  <SectionHeading eyebrow={eyebrow} title={title} description={description} />

  <ol class="mt-14 grid gap-10 lg:grid-cols-4 lg:gap-6">
    {
      steps.map((step) => (
        <li class="reveal relative flex flex-col gap-3 border-t-2 border-ink/15 pt-6">
          <span class="absolute -top-[9px] left-0 h-[17px] w-[17px] rounded-full border-2 border-signal bg-canvas" aria-hidden="true" />
          <span class="font-mono text-xs text-signal">{step.number}</span>
          <h3 class="font-display text-xl font-semibold text-ink">{step.title}</h3>
          <p class="font-mono text-xs uppercase tracking-wide text-ink-soft/60">{step.duration}</p>
          <p class="text-[15px] leading-relaxed text-ink-soft/85">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>
