---
interface CaseStudyMetric {
  label: string;
  before: string;
  after: string;
}

interface Props {
  entry: {
    clientName: string;
    industry: string;
    sourcePlatform: string;
    summary: string;
    metrics: CaseStudyMetric[];
    isPlaceholder?: boolean;
  };
}

const { entry } = Astro.props;
const { clientName, industry, sourcePlatform, summary, metrics, isPlaceholder } = entry;
---

<article class="reveal relative flex flex-col gap-5 rounded-md border border-ink/10 bg-porcelain p-6 sm:p-8">
  {
    isPlaceholder && (
      <span class="absolute right-4 top-4 rounded-sm bg-ember-soft px-2 py-1 font-mono text-[10px] uppercase tracking-wide text-ember">
        Przykładowe dane
      </span>
    )
  }

  <div>
    <p class="font-mono text-xs uppercase tracking-wide text-ink-soft/60">
      {industry} · z {sourcePlatform}
    </p>
    <h3 class="mt-1 font-display text-xl font-semibold text-ink">{clientName}</h3>
  </div>

  <p class="text-[15px] leading-relaxed text-ink-soft/85">{summary}</p>

  <dl class="mt-2 grid grid-cols-1 gap-3 border-t border-ink/10 pt-5 sm:grid-cols-3">
    {
      metrics.slice(0, 3).map((metric) => (
        <div>
          <dt class="text-xs text-ink-soft/60">{metric.label}</dt>
          <dd class="mt-1 flex items-center gap-2 font-mono text-sm">
            <span class="text-ember">{metric.before}</span>
            <span class="text-ink-soft/30" aria-hidden="true">→</span>
            <span class="font-medium text-mint">{metric.after}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</article>
