---
import { Image } from 'astro:assets';
import TrendIllustration from './TrendIllustration.astro';
import shopifyLogo from '../assets/images/shopify-logo.png';
---

<section class="relative overflow-hidden">
  <div class="relative z-10 mx-auto max-w-content px-5 pb-4 pt-14 sm:px-8 sm:pt-20 lg:pb-0">
    <div class="max-w-2xl">
      <p class="inline-flex items-center gap-2.5 rounded-full border border-ink/10 bg-porcelain/80 py-1.5 pl-3 pr-4 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-soft">
        <span class="status-dot relative h-1.5 w-1.5 rounded-full bg-mint text-mint" aria-hidden="true"></span>
        Migracja e-commerce → Shopify
      </p>

      <h1 class="mt-6 text-balance font-display text-[2.6rem] font-semibold leading-[1.06] tracking-tight text-ink sm:text-5xl lg:text-[3.4rem]">
        Migracja do{' '}
        <span class="inline-flex items-baseline gap-2 whitespace-nowrap">
          Shopify
          <span
            class="animate-float inline-flex h-[0.85em] w-[0.85em] shrink-0 translate-y-[0.08em] items-center justify-center rounded-[0.22em] bg-white p-[0.1em] shadow-md shadow-ink/10 ring-1 ring-ink/10"
          >
            <Image src={shopifyLogo} alt="" width={48} height={48} class="h-full w-full object-contain" />
          </span>
        </span>{' '}
        to inwestycja w&nbsp;konwersję —
        <span class="font-accent italic text-ink">nie koszt techniczny.</span>
      </h1>

      <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-soft/85">
        Migracja do Shopify to szybszy checkout, lepszy UX&amp;UI Design oraz
        możliwość rozwoju sprzedaży na inne rynki, co przekłada się na lepszą
        konwersję i większy przychód.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <button
          type="button"
          data-open-audit-modal
          class="group inline-flex items-center justify-center gap-2 rounded-full bg-ink px-7 py-3.5 text-base font-semibold text-porcelain transition-colors hover:bg-signal"
        >
          Umów audyt
          <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
        </button>
        <a
          href="#zakres"
          class="inline-flex items-center justify-center rounded-full border border-white/40 bg-white/25 px-7 py-3.5 text-base font-semibold text-ink shadow-sm backdrop-blur-md transition-colors hover:border-signal/50 hover:bg-white/40 hover:text-signal"
        >
          Zobacz zakres usługi
        </a>
      </div>
    </div>
  </div>

  <div class="relative z-0 pb-10 sm:pb-16 lg:-mt-[170px] lg:pb-24 xl:-mt-[210px]">
    <TrendIllustration />
  </div>
</section>
