---
import { Image } from 'astro:assets';
import DiagnosticPanel from './DiagnosticPanel.astro';
import shopifyLogo from '../assets/images/shopify-logo.png';
---

<section class="relative overflow-hidden">
  <div
    class="bg-grid pointer-events-none absolute inset-0 text-ink/[0.05]"
    style="mask-image: radial-gradient(ellipse 70% 60% at 45% 30%, black 35%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 45% 30%, black 35%, transparent 100%);"
    aria-hidden="true"
  >
  </div>
  <div class="pointer-events-none absolute -top-32 right-[-12%] h-[30rem] w-[30rem] rounded-full bg-signal/[0.07] blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute bottom-[-20%] left-[-10%] h-[24rem] w-[24rem] rounded-full bg-mint/[0.08] blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-content px-5 pb-20 pt-14 sm:px-8 sm:pt-20 lg:pb-28">
    <div class="grid gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-12">
      <div>
        <p class="inline-flex items-center gap-2.5 rounded-full border border-ink/10 bg-porcelain/80 py-1.5 pl-3 pr-4 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-soft">
          <span class="status-dot relative h-1.5 w-1.5 rounded-full bg-mint text-mint" aria-hidden="true"></span>
          Migracja e-commerce → Shopify
        </p>

        <h1 class="mt-6 max-w-2xl text-balance font-display text-[2.6rem] font-semibold leading-[1.06] tracking-tight text-ink sm:text-5xl lg:text-[3.4rem]">
          Migracja do{' '}
          <span class="inline-flex items-baseline gap-2 whitespace-nowrap">
            Shopify
            <span
              class="animate-float inline-flex h-[0.85em] w-[0.85em] shrink-0 translate-y-[0.08em] items-center justify-center rounded-[0.22em] bg-white p-[0.1em] shadow-md shadow-ink/10 ring-1 ring-ink/10"
            >
              <Image src={shopifyLogo} alt="" width={48} height={48} class="h-full w-full object-contain" />
            </span>
          </span>{' '}
          to inwestycja w&nbsp;konwersję —
          <span class="box-decoration-clone rounded-sm bg-signal-soft/60 px-1.5 text-ink">nie koszt techniczny.</span>
        </h1>

        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-soft/85">
          Przenoszę sklepy z WooCommerce, PrestaShop i Magento na Shopify tak,
          żeby szybszy checkout, zero utraty SEO i uporządkowany katalog
          produktów przełożyły się na liczby, nie tylko na nowy wygląd.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href="#kontakt"
            class="group inline-flex items-center justify-center gap-2 rounded-full bg-ink px-7 py-3.5 text-base font-semibold text-porcelain transition-colors hover:bg-signal"
          >
            Umów audyt
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
          <a
            href="#zakres"
            class="inline-flex items-center justify-center rounded-full border border-ink/20 px-7 py-3.5 text-base font-semibold text-ink transition-colors hover:border-signal hover:text-signal"
          >
            Zobacz zakres usługi
          </a>
        </div>
      </div>

      <DiagnosticPanel />
    </div>
  </div>
</section>
