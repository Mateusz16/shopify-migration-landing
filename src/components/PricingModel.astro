---
import { fetchSingleton } from '../lib/sanity/content';
import { pricingModelQuery } from '../lib/sanity/queries';
import { pricingModelDefault } from '../lib/sanity/defaults';

const pricing = await fetchSingleton(pricingModelQuery, pricingModelDefault);
const {
  eyebrow,
  title,
  description,
  migrationLabel,
  migrationHeadline,
  migrationBody,
  maintenanceLabel,
  maintenancePriceFrom,
  maintenancePriceTo,
  maintenanceBody,
  capacityNote,
} = pricing;
---

<section id="cennik" class="bg-ink text-porcelain">
  <div class="mx-auto max-w-content px-5 py-20 sm:px-8 sm:py-28">
    <div class="max-w-2xl reveal">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-mint font-medium">{eyebrow}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-semibold text-porcelain">
        {title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-porcelain/70">
        {description}
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      <div class="reveal rounded-md border border-porcelain/15 p-7 sm:p-8">
        <p class="font-mono text-xs uppercase tracking-wide text-porcelain/50">{migrationLabel}</p>
        <p class="mt-3 font-display text-2xl font-semibold text-porcelain">{migrationHeadline}</p>
        <p class="mt-4 text-[15px] leading-relaxed text-porcelain/70">
          {migrationBody}
        </p>
      </div>

      <div class="reveal rounded-md border border-porcelain/15 p-7 sm:p-8">
        <p class="font-mono text-xs uppercase tracking-wide text-porcelain/50">{maintenanceLabel}</p>
        <p class="mt-3 font-display text-2xl font-semibold text-porcelain">
          {maintenancePriceFrom}–{maintenancePriceTo} <span class="text-lg font-normal text-porcelain/60">PLN netto / mies.</span>
        </p>
        <p class="mt-4 text-[15px] leading-relaxed text-porcelain/70">
          {maintenanceBody}
        </p>
      </div>
    </div>

    <div class="reveal mt-8 flex items-start gap-4 rounded-md border border-mint/30 bg-mint/10 p-6">
      <span class="font-mono text-sm text-mint">!</span>
      <p class="text-[15px] leading-relaxed text-porcelain/80">
        {capacityNote}
      </p>
    </div>
  </div>
</section>
