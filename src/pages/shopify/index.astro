---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import AudienceFilter from '../../components/AudienceFilter.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import PricingModel from '../../components/PricingModel.astro';
import CaseStudies from '../../components/CaseStudies.astro';
import AboutMe from '../../components/AboutMe.astro';
import ContactCta from '../../components/ContactCta.astro';
import { fetchSingleton } from '../../lib/sanity/content';
import { siteSettingsQuery } from '../../lib/sanity/queries';
import { siteSettingsDefault } from '../../lib/sanity/defaults';

const siteSettings = await fetchSingleton(siteSettingsQuery, siteSettingsDefault);
const title = siteSettings.metaTitle;
const description = siteSettings.metaDescription;
---

<BaseLayout title={title} description={description}>
  <Hero />
  <AudienceFilter />
  <ServiceGrid />
  <ProcessSteps />
  <PricingModel />
  <CaseStudies />
  <AboutMe />
  <ContactCta />
</BaseLayout>
