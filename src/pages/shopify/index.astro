---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import AudienceFilter from '../../components/AudienceFilter.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import PricingModel from '../../components/PricingModel.astro';
import CaseStudies from '../../components/CaseStudies.astro';
import AboutMe from '../../components/AboutMe.astro';
import ContactCta from '../../components/ContactCta.astro';

const title = 'Migracja sklepu do Shopify — audyt, wdrożenie, wzrost konwersji';
const description =
  'Migracja sklepu e-commerce do Shopify wyceniana po audycie: szybszy checkout, zero utraty SEO, pełna migracja produktów i comiesięczne wsparcie. Maks. 4-5 klientów jednocześnie.';
---

<BaseLayout title={title} description={description}>
  <Hero />
  <AudienceFilter />
  <ServiceGrid />
  <ProcessSteps />
  <PricingModel />
  <CaseStudies />
  <AboutMe />
  <ContactCta />
</BaseLayout>
